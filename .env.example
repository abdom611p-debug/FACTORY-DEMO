# Environment Configuration
# Copy this to .env

# Server
HOST=0.0.0.0
PORT=8000

# Camera / Demo Configuration
# Can be '0' for local webcam, or a path to a video file, or RTSP url.
DEFAULT_CAMERA_SOURCE=0

# Detection Settings
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Tracking
MAX_AGE=30
N_INIT=3

# Demo Face Recognition
# Path to reference images for the demo
FACE_DB_PATH=./data/faces

# Storage for mock database
DB_PATH=./data/db.json
