# EGIC AI Engine — copy to .env

HOST=0.0.0.0
PORT=8765

# Mirror AI events (fire, smoking, PPE …) to the EGIC platform dashboard
EGIC_PLATFORM_URL=http://localhost:8080
# Optional ASP.NET backend (legacy) — leave empty to disable
BACKEND_API_URL=

# Load every model at startup (recommended on servers)
PRELOAD_MODELS=true
# Comma-separated allowed web origins ("*" for the demo, e.g. https://egic.vercel.app in production)
CORS_ORIGINS=*

# Fire & smoke
FIRE_CONFIDENCE=0.3
FIRE_ALARM_COOLDOWN_SEC=60
PPE_ALARM_COOLDOWN_SEC=30

# Local camera pipeline (/ws/live) — off on servers
ENABLE_LOCAL_CAMERA=false
DEFAULT_CAMERA_SOURCE=0
